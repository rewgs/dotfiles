#!/usr/bin/env python3


import os
from dataclasses import dataclass
from pathlib import Path


@dataclass
class App:
    name: str
    alias: str | None = None
    _path: Path | None = None

    @property
    def path(self) -> Path:
        if self._path is None:
            self._path = dotfiles_dir.joinpath(self.name)
        return self._path


